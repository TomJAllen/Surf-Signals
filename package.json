{
  "name": "surf-signals",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-mediapipe.mjs && next dev",
    "build": "node scripts/copy-mediapipe.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@vercel/analytics": "1.3.1",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "next": "15.5.28",
    "next-auth": "^4.24.13",
    "pg": "^8.17.2",
    "posthog-js": "1.435.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "dotenv": "^17.2.3",
    "eslint": "^8",
    "eslint-config-next": "15.5.28",
    "jsdom": "^23.0.0",
    "postcss": "^8",
    "prisma": "^7.3.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^1.1.0"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.19"
  }
}
