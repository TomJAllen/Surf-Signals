# Postgres connection string (Neon, Supabase, local...)
# Add ?sslmode=disable for a plain local Postgres without TLS
DATABASE_URL="postgresql://user:password@localhost:5432/surf_signals?sslmode=disable"
# Only set to "false" for a database with a self-signed certificate
# DATABASE_SSL_REJECT_UNAUTHORIZED="false"

# NextAuth: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Used by `npm run db:seed` to create the admin account.
# If ADMIN_PASSWORD is unset, a random one is generated and printed once.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""

# Vercel Blob token for admin image uploads (created automatically when you
# add a Blob store to the project in Vercel; copy it here for local dev)
BLOB_READ_WRITE_TOKEN=""
