# Postgres connection string (Neon, Supabase, local...)
# Add ?sslmode=disable for a plain local Postgres without TLS
DATABASE_URL="postgresql://user:password@localhost:5432/surf_signals?sslmode=disable"
# Verify the database's TLS certificate against this CA (PEM text or base64 of it).
# For Supabase: Project Settings > Database > SSL Configuration > Download certificate.
# DATABASE_CA_CERT=""
# Last resort only (encrypted but NOT verified):
# DATABASE_SSL_REJECT_UNAUTHORIZED="false"

# NextAuth: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Used by `npm run db:seed` to create the admin account.
# If ADMIN_PASSWORD is unset, a random one is generated and printed once.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""

# Comma-separated emails allowed to use the admin area. Admins need BOTH this AND
# role "admin" in the database. In production, if unset, nobody is an admin.
ADMIN_EMAILS="you@example.com"

# Vercel Blob token for admin image uploads (created automatically when you
# add a Blob store to the project in Vercel; copy it here for local dev)
BLOB_READ_WRITE_TOKEN=""

# Secret Vercel Cron sends to /api/cron/keepalive (daily DB ping so Supabase free tier does not pause).
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# Anonymous product analytics (PostHog, free tier). Leave the key empty to disable.
# In PostHog project settings, turn on "Discard client IP data".
NEXT_PUBLIC_POSTHOG_KEY=""
# "us" (default) or "eu": must match where your PostHog project is hosted
NEXT_PUBLIC_POSTHOG_REGION="us"

# Shown on the Privacy Policy and Terms pages
NEXT_PUBLIC_OPERATOR_NAME="Tom Allen"
NEXT_PUBLIC_CONTACT_EMAIL=""

# Password reset emails via Resend (optional). Verify the sending domain in Resend first.
RESEND_API_KEY=""
# EMAIL_FROM="Patrol Ready <noreply@patrolready.au>"
